# ── Ants backend environment ────────────────────────────────────────────────
# Copy to .env (or set in Railway/Render dashboard). Everything is optional —
# the app runs without any of these, with AI features in fallback mode.
#
# main.py loads backend/.env.local then backend/.env, and neither overrides a
# variable already set in the real process env — so the hosting dashboard
# always wins in production.

# Enables AI: screenshot OCR, punched-up analysis copy, Ask Ants chat.
# Get one free at https://aistudio.google.com/apikey
# A key that is set but rejected shows up as aiLastError on /healthz rather
# than as a silent downgrade to the non-AI fallback.
GEMINI_API_KEY=

# Model for all AI calls. Must match ai.py's default, or the two disagree
# about what "default" means depending on whether this file was copied.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated frontend origins allowed by CORS.
# Add your deployed frontend, e.g. https://ants.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Set by Railway/Render automatically; local default 8000.
PORT=8000
